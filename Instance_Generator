import random

def generate_knp_file(filename, n, b1, b2):
    # Defining placeholders for the 5 columns
    # In a real scenario, you'd likely pass these in as lists
    a1_values = [random.randint(1, b1) for _ in range(n)]
    Fixed = [random.randint(1, 100) for _ in range(n)]
    lowers = [random.randint(10, 200) for _ in range(n)]
    capacities = [random.randint(low, b2) for low in lowers]
    variable_vals = [random.randint(1, 10) for _ in range(n)]

    with open(filename, 'w') as f:
        # First row: n, b1, b2
        f.write(f"{n}\t{b1}\t{b2}\n\n")  # Includes the empty row

        # Rows for each of the n items
        for i in range(n):
            row = [
                a1_values[i], 
                Fixed[i], 
                capacities[i], 
                lowers[i], 
                variable_vals[i]
            ]
            # Joining with tabs for a clean column look
            f.write("\t".join(map(str, row)) + "\n")

    print(f"File '{filename}' generated successfully with n={n}.")

# Usage
for i in range(5):
    n = 10
    b1 = random.randint(100,500)
    b2 = random.randint(500, 1000)
    filename = f"{n}_{i}.knp"
    generate_knp_file(filename, n, b1, b2)
